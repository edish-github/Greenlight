{
  "name": "greenlight",
  "version": "0.1.0",
  "private": true,
  "description": "A pre-publish linter for video. Locates, cites and repairs advertiser-friendly policy risk.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "scan": "tsx scripts/scan-cli.ts",
    "detect": "tsx scripts/detect-cli.ts",
    "policy:check": "tsx scripts/check-policy-freshness.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "samples": "tsx scripts/precompute-samples.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.400.0",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
