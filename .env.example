# ---------------------------------------------------------------------------
# Greenlight environment. Copy to .env.local and fill in.
# No value in this file is a secret. Never commit .env.local.
# ---------------------------------------------------------------------------

# ASR tier 1 (required for scanning your own files; NOT required for sample clips)
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo

# ASR tier 2 fallback (optional)
OPENAI_API_KEY=

# Adjudication + vision (required for scanning your own files)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Where scan artifacts are written. Relative paths resolve from the repo root.
GREENLIGHT_DATA_DIR=scans

# Active policy pack. Bumping this invalidates every cached scan by design.
GREENLIGHT_PACK=src/policy/packs/youtube-afg-2026.09.yaml

# debug | info | warn | error
LOG_LEVEL=info
